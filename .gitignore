.vscode/
.claude/local.settings.json
n8n-workflows/

# Local working copy of the canonical plan — owner reference only, never publish.
PLAN.md

# Per-session resume prompts — short notes to ourselves for cold-start continuation.
RESUME.md

# Secrets and per-instance env (the *.example variants ARE committed)
.dev.vars
.env
.env.*

# Deploys render their config from workers/server/wrangler.example.jsonc plus deployments/<name>/
# (npm run deploy -- <name>). A root wrangler config from before that holds an
# account ID and KV namespace IDs, so any left in a checkout stays out of git.
wrangler.jsonc
wrangler.json
wrangler.toml

# Local snapshots of live KV config (real Autotask URL, real list IDs). The
# sanitized templates in config-examples/ ARE committed; these real dumps aren't.
config-live/

# Named deployments: per-deployment files hold account IDs, KV IDs, hostnames
# and secrets. deployment.example.jsonc at the root is committed.
deployments/

# Wrangler-generated artifacts and dependencies
node_modules
.wrangler/
dist/
**/worker-configuration.d.ts

# Node host databases: a local SQLite file holds sealed tokens, OAuth grants
# and the plaintext task cache.
*.sqlite
*.sqlite-*

# Logs, scratch, OS noise
*.log
*.backup
.DS_Store
.claude/settings.local.json
.claude/*.md
PLAN-MY-DAY.md
PLAN-MOVE-TASK.md

# Local design specs / brainstorming docs (not tracked)
docs/superpowers/

# Claude Code per-user files: they can hold tokens copied from approved commands
**/CLAUDE.local.md
