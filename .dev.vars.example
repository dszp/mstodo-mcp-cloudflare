# Copy this file to `deployments/<name>/.dev.vars` and fill in the values below.
# That file is gitignored; this `.example` is committed as a shape reference.
# `npm run dev -- <name>` reads it for local runs, and `npm run secrets -- <name>`
# pushes it to the deployed Worker as encrypted secrets, so nothing here appears
# in source.
#
# Any value may be a literal OR a 1Password secret reference of the form
# `op://<vault>/<item>/<field>`. Both commands resolve references via the `op`
# CLI (needs `op signin` or OP_SERVICE_ACCOUNT_TOKEN) and leave literals
# untouched, so you can keep secrets out of the file:
#   MS_CLIENT_SECRET=op://Dev/Potem Entra app/credential
# Surrounding quotes are stripped, so 1Password's "Copy Secret Reference"
# (which includes double quotes) can be pasted in verbatim.

# Microsoft Entra app registration — Azure portal → App registrations → your app
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The userPrincipalName of the Microsoft account whose To Do data this server
# reads/writes (case-insensitive). Sign-in rejects every other account. A match
# on the account's mail address instead also needs OWNER_OBJECT_ID below.
OWNER_EMAIL=

# The owner's Microsoft account object ID: the `id` that the whoami tool returns.
# When set, sign-in also requires /me.id to match, so another account that
# carries the same address is refused. Required when MS_TENANT_ID is `common`
# or `organizations`, or when OWNER_EMAIL is the mail address rather than the
# userPrincipalName; recommended otherwise.
OWNER_OBJECT_ID=
