{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "paths": { "@potem/core/*": ["./packages/core/*"] },
    "noEmit": true
  },
  "include": ["src/**/*", "packages/**/*", "test/**/*", "test-node/**/*", "worker-configuration.d.ts"]
}
